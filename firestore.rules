rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Only authenticated users can create or update their own profile.
    match /profiles/{userId} {
      allow create, update, read: if request.auth != null && request.auth.uid == userId;
    }

    // Only authenticated users can create or update their own role document.
    match /user_roles/{userId} {
      allow create, update, read: if request.auth != null && request.auth.uid == userId;
    }

    // Allow authenticated users to create their own account request.
    match /account_requests/{requestId} {
      allow create: if request.auth != null && request.resource.data.user_id == request.auth.uid;
      allow read: if request.auth != null;
    }

    // Deny all other access by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
