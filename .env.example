# Supabase - client-side (safe to expose, used in the browser)
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Supabase - server-side (used during SSR / server functions)
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Server-only secret. NEVER prefix this with VITE_ and never expose it to the browser.
SUPABASE_SERVICE_ROLE_KEY=
